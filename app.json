{
  "expo": {
    "name": "Directorio de Comercios Concepción del Uruguay",
    "slug": "mi-primera-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/directorio-icon.png",
    "scheme": "directoriocdelu",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EAF6FF",
        "foregroundImage": "./assets/images/directorio-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.grupo32.integrador",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/directorio-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/directorio-splash.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#F7FBFF",
          "dark": {
            "image": "./assets/images/directorio-splash.png",
            "backgroundColor": "#0F1115"
          }
        }
      ],
      "@react-native-vector-icons/ionicons",
      "expo-secure-store",
      "expo-sqlite",
      "expo-video",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "La app usa la cámara para escanear el código QR de las promociones y sacar fotos para las reseñas.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "La app usa tu ubicación para mostrarte los comercios cercanos y calcular distancias."
        }
      ],
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "391ba1cb-608c-433f-b97c-8becfb67aa21"
      },
      "apiUrl": "http://10.0.2.2:3000"
    }
  }
}
