{
  "expo": {
    "name": "Directorio de Comercios Concepción del Uruguay",
    "slug": "directorio-comercios-cdelu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/directorio-icon.png",
    "scheme": "directoriocdelu",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EAF6FF",
        "foregroundImage": "./assets/images/directorio-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.grupo32.integrador"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/directorio-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/directorio-splash.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#F7FBFF",
          "dark": {
            "image": "./assets/images/directorio-splash.png",
            "backgroundColor": "#0F1115"
          }
        }
      ],
      "@react-native-vector-icons/ionicons",
      "expo-secure-store",
      "expo-sqlite",
      "expo-video",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "391ba1cb-608c-433f-b97c-8becfb67aa21"
      },
      "apiUrl": "http://10.0.2.2:3000"
    }
  }
}
